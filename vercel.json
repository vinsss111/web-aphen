{
  "version": 2,
  "name": "web-aphen",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    // Serve static assets from the public folder directly
    { "src": "/assets/(.*)", "dest": "/public/assets/$1" },
    { "src": "/uploads/(.*)", "dest": "/public/uploads/$1" },
    { "src": "/favicon.ico", "dest": "/public/favicon.ico" },
    { "src": "/robots.txt", "dest": "/public/robots.txt" },

    // API/webhook routes (if any) can be forwarded to the serverless function
    { "src": "/api/(.*)", "dest": "/api/index.php" },

    // Fallback: let the PHP serverless function handle the rest (routes)
    { "src": "/(.*)", "dest": "/api/index.php" }
  ]
}