{
  "version": 2,
  "name": "web-aphen",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1",
      "config": {
        "maxDuration": 30,
        "memory": 1024,
        "phpVersion": "8.2"
      }
    }
  },
  "routes": [
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "/public/favicon.ico"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}